{
  "name": "orientsol-web",
  "private": true,
  "version": "3.0.0",
  "description": "OrientSol 3.0 - Software Avanzado de Cálculo Solar Fotovoltaico y Térmico",
  "author": "OrientSol Team",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-pyodide && tsc && vite build",
    "preview": "vite preview",
    "prepare-pyodide": "node scripts/copy-pyodide.js",
    "electron:start": "electron .",
    "electron:test": "electron scripts/test-electron-full.mjs",
    "app:dev": "vite build && electron .",
    "app:desktop": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win --x64",
    "pack:win": "npm run build && electron-builder --dir",
    "cap:sync": "npm run build && cap sync android",
    "cap:open:android": "cap open android",
    "build:apk": "npm run build && cap sync android && node scripts/build-android-apk.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.117.2",
    "pyodide": "^314.0.7",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.orientsol.app",
    "productName": "OrientSol 3.0",
    "copyright": "Copyright © 2026 OrientSol",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
