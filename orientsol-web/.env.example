# Supabase Configuration for OrientSol Web (Plantilla)
# Obten estos valores en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Mobile Android / Zero-Secret Backend Gateway (Opcional):
# Si configuras esta URL, la app móvil se comunicará con este backend proxy
# y NO almacenará credenciales de base de datos directamente en el APK.
# VITE_BACKEND_API_URL=https://api.tudominio.com

